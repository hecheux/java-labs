<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>WebServletV2</display-name>
    

    
    <servlet>
        <servlet-name>MainServlet</servlet-name>
        <servlet-class>com.tpprojects.servlets.MainServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.tpprojects.servlets.LoginServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.tpprojects.servlets.LogoutServlet</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>AddAnnouncementServlet</servlet-name>
        <servlet-class>com.tpprojects.servlets.AddAnnouncementServlet</servlet-class>
    </servlet>
    
    
    <servlet-mapping>
        <servlet-name>MainServlet</servlet-name>
        <url-pattern></url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>AddAnnouncementServlet</servlet-name>
        <url-pattern>/add-announcement</url-pattern>
    </servlet-mapping>
    
    
    <context-param>
        <param-name>usersFile</param-name>
        <param-value>/WEB-INF/users.txt</param-value>
    </context-param>
    
</web-app>
